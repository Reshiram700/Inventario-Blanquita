<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blanquita_Inventarios.PrototipoMAUI.MainPage"
             xmlns:viewmodel="clr-namespace:Blanquita_Inventarios.PrototipoMAUI.ViewModel"
             x:DataType="viewmodel:MainVM"
             Title="">
    <ScrollView>
        <StackLayout>
            <Grid HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 20, 0, 50">
                    <Label Text="SISTEMA DE TOMA DE INVENTARIOS" HorizontalOptions="Center" Margin="0, 0, 0, 10" FontSize="24" TextColor="#001968"/>                    
                    <Image Source="logo.png" HorizontalOptions="Center" WidthRequest="220" VerticalOptions="Center"/>

                    <Label Text="Bienvenido Alan García" HorizontalOptions="Center" Margin="0, 0, 0, 10" FontSize="18" TextColor="#001968"/>
                </StackLayout>

                <StackLayout Grid.Row="1" Grid.Column="0" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config"  WidthRequest="90" HeightRequest="90" Command="{Binding ParametrizacionCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Parametrización" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Row="1" Grid.Column="1" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config" WidthRequest="90" HeightRequest="90" Command="{Binding ConfiguracionCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Configuración" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Row="2" Grid.Column="0" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config" WidthRequest="90" HeightRequest="90" Command="{Binding CatalogosCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Traer Catálogos" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Row="2" Grid.Column="1" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config" WidthRequest="90" HeightRequest="90" Command="{Binding CapturarCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Capturar Marbete" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Row="3" Grid.Column="0" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config" WidthRequest="90" HeightRequest="90" Command="{Binding CapturadosCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Marbetes Capturados" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Row="3" Grid.Column="1" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config" WidthRequest="90" HeightRequest="90" Command="{Binding PendientesCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Marbetes Pendientes" HorizontalOptions="Center" />
                </StackLayout>
                <StackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Padding="5" Orientation="Vertical" Margin="0, 10">
                    <ImageButton Source="icon_config" WidthRequest="90" HeightRequest="90" Command="{Binding BorrarCommand}" HorizontalOptions="Center" BackgroundColor="#ec851a" CornerRadius="10" Padding="5"/>
                    <Label Text="Borrar Información" HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </StackLayout>
    </ScrollView>

</ContentPage>
