<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blanquita_Inventarios.PrototipoMAUI.CatalogosPage"
             xmlns:viewmodel="clr-namespace:Blanquita_Inventarios.PrototipoMAUI.ViewModel"
             x:DataType="viewmodel:CatalogosVM"
             Title="">
    <VerticalStackLayout>
        <StackLayout VerticalOptions="FillAndExpand">
            <Label 
                Text="TRAER CATÁLOGOS"                 
                HorizontalOptions="Center" FontSize="20" />            
            <StackLayout Margin="0, 80, 0, 10">
                <Button x:Name="btnMarbetes" Text="MARBETES" CornerRadius="10"
                    WidthRequest="200" HeightRequest="55" BackgroundColor="#001968"
                    TextColor="#ffffff" Command="{Binding MarbetesCommand}" />
            </StackLayout>
            <StackLayout Margin="0, 10">
                <Button x:Name="btnArticulos" Text="ARTÍCULOS" CornerRadius="10"
                    WidthRequest="200" HeightRequest="55" BackgroundColor="#001968"
                    TextColor="#ffffff" Command="{Binding ArticulosCommand}" />
            </StackLayout>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>