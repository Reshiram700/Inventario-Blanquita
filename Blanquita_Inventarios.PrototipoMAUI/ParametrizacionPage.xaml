<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blanquita_Inventarios.PrototipoMAUI.ParametrizacionPage"
             xmlns:viewmodel="clr-namespace:Blanquita_Inventarios.PrototipoMAUI.ViewModel"
             x:DataType="viewmodel:ParametrizacionVM"
             Title="">
    <VerticalStackLayout>
        <StackLayout VerticalOptions="FillAndExpand">
            <Label 
                Text="PARAMETRIZACIÓN"
                VerticalOptions="Center" 
                HorizontalOptions="Center" FontSize="20" />
            <Grid Margin="20, 50, 20, 50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Text="Nombre de la PDA" />
                <Entry Grid.Row="0" Grid.Column="1" Text="" />
            </Grid>
            <StackLayout>
                <Button x:Name="btnActualizar" Text="ACTUALIZAR" CornerRadius="10"
                    WidthRequest="200" HeightRequest="55" BackgroundColor="#001968"
                    TextColor="#ffffff" Command="{Binding ActualizarCommand}" />
            </StackLayout>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>