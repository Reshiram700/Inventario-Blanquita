<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blanquita_Inventarios.PrototipoMAUI.Login"
             xmlns:viewmodel="clr-namespace:Blanquita_Inventarios.PrototipoMAUI.ViewModel"
             x:DataType="viewmodel:LoginVM"
             Title="">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Padding="0,40,0,40">
                <Label Text="Sistema de Toma de Inventarios" TextColor="#474747" FontFamily=""
                    FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
            </StackLayout>
            <Grid Grid.Row="1">
                <ScrollView>
                    <StackLayout Padding="5, 15">
                        <Image Source="logo.png" HorizontalOptions="Center" WidthRequest="220" VerticalOptions="Center"/>
                        <StackLayout Grid.Row="1" Orientation="Vertical" Padding="20, 50" VerticalOptions="End" >
                            <Entry x:Name="entUsuario" Text=""
                               Placeholder="Usuario" TextColor="#000000"
                               PlaceholderColor="Gray" HorizontalTextAlignment="Center"
                               VerticalOptions="Center" Margin="0, 5" />
                            <Grid>
                                <Entry x:Name="entPassword" BackgroundColor="#ffffff"
                                   Placeholder="Contraseña" IsPassword="true"
                                   TextColor="#000000" PlaceholderColor="Gray"
                                   Text="" Keyboard="Default" AutomationId="Password"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center"/>                                
                            </Grid>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <StackLayout Grid.Row="2">
                <Button x:Name="BtnIngresar" Text="Ingresar" CornerRadius="0"
                    HeightRequest="55" BackgroundColor="#001968" 
                    TextColor="#ffffff" Command="{Binding IngresarCommand}" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>