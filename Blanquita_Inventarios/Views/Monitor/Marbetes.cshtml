@model Blanquita_Inventarios.ViewModels.GenericVM

@{
    ViewBag.Title = "Marbetes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Avance por Marbete
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            @using (@Html.BeginForm("Marbetes", "Monitor", FormMethod.Post, new { id = "myForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-success margin-right-10 margin-bottom-5">
                                            Refresh
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <button type="button" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Index", "Monitor")'">
                                            Regresar
                                            <i class="fa fa-chevron-circle-left"></i>
                                        </button>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Nombre del Inventario General</label>
                                                    <select id="ddlFiltroPerfil" class="form-control">
                                                        <option>- Seleccione -</option>
                                                        <option>Inventario Central</option>
                                                        <option selected>Inventario de Prueba</option>
                                                        <option>Inventario Estacion Norte</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Zona</label>
                                                    <select id="ddlFiltroPerfil" class="form-control">
                                                        <option>- Seleccione -</option>
                                                        <option>Zona Centro</option>
                                                        <option selected>Zona Norte</option>
                                                        <option>Zona Sur</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Marbete</label>
                                                    <input type="text" id="txtFiltroEmail" class="form-control" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <table style="margin-left: 20px;">
                                                <tr>
                                                    <td rowspan="2"><img src="~/Content/img/logo.png" /></td>
                                                    <td rowspan="2">
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                    </td>
                                                    <td colspan="3">
                                                        <h3 style="letter-spacing: 2px;">Avance del 60% monto $13,200.00 Tiempo 2:40</h3>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <b>Nombre del Inventario:</b> Inventario de Prueba
                                                    </td>
                                                    <td>
                                                        &nbsp;&nbsp;&nbsp;
                                                    </td>
                                                    <td>
                                                        <b>Almacén:</b> Almacén 1
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>

                                        <table class="table table-bordered mb-0 table-sm dataTable-simple tabla-datos">
                                            <thead>
                                                <tr class="bg-light headerCustom">
                                                    <th>
                                                        <input name="control" value="Almacén"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Zona"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Marbete"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Estatus"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Importe"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Tiempo"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Nombre"
                                                               class="btn headerCustom" />
                                                    </th>                                                    
                                                    <th><div style="font-size:14px!important;text-align:center">Acciones</div></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Listado != null && Model.Listado.Count > 0)
                                                {
                                                    foreach (var item in Model.Listado)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo00)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo01)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo02)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo03)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo04)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo05)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Campo06)
                                                            </td>
                                                            <td align="center">
                                                                <button class="btn btn-xs green-jungle btn-detalles" type="button"
                                                                        onclick="location.href='@Url.Action("Detalle","Monitor")'">
                                                                    <i class="fa fa-edit"></i>
                                                                    &nbsp;Detalle de Marbete
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script>
        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: true,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"] // change per page values here
                ],
                lengthChange: false, //Oculta el listado de elementos por pagina
                // set the initial value
                pageLength: 25,
                info: false
            });
        });
    </script>
}
