@model Blanquita_Inventarios.ViewModels.GenericVM

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Formato 1</title>
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">

            @foreach (var item in Model.Listado)
            {
                <div class="col-md-4" style="border: 1px solid #000;">
                    <table style="margin-left: auto; margin-right: auto;">
                        <tr>
                            <td rowspan="2" style="border-bottom: 1px solid #000000;">
                                <img src="~/Content/img/logo.png" />
                            </td>
                            <td class="text-right" style="width: 300px;">
                                <b>Almacén: </b> @item.Campo00
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right" style="border-bottom: 1px solid #000000;">
                                <b>Marbete: </b> @item.Campo02
                            </td>
                        </tr>
                        <tr>
                            &nbsp;
                        </tr>
                        <tr>
                            <td style="height: 70px; border: 1px solid #000000; vertical-align:top;">
                                Área: <br />
                                @item.Campo00
                            </td>
                            <td style="height: 70px; border: 1px solid #000000; vertical-align:top;">
                                Departamento:
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="height: 70px; border: 1px solid #000000; vertical-align:top;">
                                Notas:
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                &nbsp;
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <table style="width: 100%;">
                                    <tr>
                                        <td>
                                            <b>Totales de área</b> Piezas
                                        </td>
                                        <td style="border-bottom: 1px solid #000000; width: 63%;">
                                            &nbsp;
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="border-bottom: 1px solid #000000; height: 30px">
                                &nbsp;
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-center" style="height: 25px;">
                                Imprima el apellido del auditor, primera inicial
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <table style="width: 100%;">
                                    <tr>
                                        <td>
                                            Verificado por:
                                        </td>
                                        <td style="border-bottom: 1px solid #000000; width: 75%;">
                                            &nbsp;
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                &nbsp;
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-center">
                                <img src="~/Content/img/code.png" width="350" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" class="text-center">
                                @item.Campo02
                            </td>
                        </tr>
                    </table>
                </div>
            }
        </div>
    </div>
</body>
</html>
