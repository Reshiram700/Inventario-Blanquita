@model Blanquita_Inventarios.ViewModels.GenericVM

@{
    ViewBag.Title = "¿Olvidaste tu Password?";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sistema de Toma de Inventarios</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="http://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700&subset=all" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/simple-line-icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/bootstrap-switch.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/select2.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/select2-bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/components.min.css" rel="stylesheet" id="style_components" type="text/css" />
    <link href="~/Content/css/plugins.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/login.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/toastr.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/css/custom.css" rel="stylesheet" type="text/css" />
    <link rel="shortcut icon" href="favicon.ico" />
    <style>
        html {
            background-color: #26344b !important;
            text-align: center;
        }

        .login {
            background-color: transparent !important;
        }

            .login .copyright {
                color: #1e2c3e !important;
            }

        .copyright {
            color: #ffffff !important;
        }
    </style>
</head>
<body class="login">
    <div class="logo">

    </div>
    <div class="content">
        @using (Html.BeginForm("ActualizarPassword", "Home", FormMethod.Post, htmlAttributes: new { @class = "" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true)
        <div class="form">
            <h3 class="form-title" style="color:black;">Actualizar tu Password</h3>

            <div class="form-group">
                <label for="exampleInputEmail1" class="control-label visible-ie8 visible-ie9">Usuario</label>
                <input type="text" class="form-control" id="txtUsuario" placeholder="Usuario">
            </div>
            <div class="form-group">
                <label for="exampleInputEmail1" class="control-label visible-ie8 visible-ie9">Password Actual</label>
                <input type="password" class="form-control" id="txtPassword1" placeholder="Password Actual">
            </div>
            <div class="form-group">
                <label for="exampleInputEmail1" class="control-label visible-ie8 visible-ie9">Password Nuevo</label>
                <input type="password" class="form-control" id="txtPassword2" placeholder="Password Nuevo">
            </div>
            <div class="form-group">
                <label for="exampleInputEmail1" class="control-label visible-ie8 visible-ie9">Confirme Password Nuevo</label>
                <input type="password" class="form-control" id="txtPassword3" placeholder="Confirme Password Nuevo">
            </div>
            <div class="text-center">
                <input type="submit" value="Actualizar Password" class="btn blue-soft uppercase" />
            </div>
        </div>
        }
    </div>
    <div class="copyright">
        Copyright © @Html.Label(DateTime.Now.Year.ToString()) | Todos los derechos reservados
    </div>
    <!-- BEGIN CORE PLUGINS -->
    <script src="~/Content/js/jquery.min.js" type="text/javascript"></script>
    <script src="~/Content/js/bootstrap.min.js" type="text/javascript"></script>
    <script src=".~/Content/js/js.cookie.min.js" type="text/javascript"></script>
    <script src="~/Content/js/jquery.slimscroll.min.js" type="text/javascript"></script>
    <script src="~/Content/js/jquery.blockui.min.js" type="text/javascript"></script>
    <script src="~/Content/js/bootstrap-switch.min.js" type="text/javascript"></script>
    <script src="~/Content/js/jquery.validate.min.js" type="text/javascript"></script>
    <script src="~/Content/js/additional-methods.min.js" type="text/javascript"></script>
    <script src="~/Content/js/select2.full.min.js" type="text/javascript"></script>
    <script src="~/Content/js/app.min.js" type="text/javascript"></script>
    <script src="~/Content/js/login.min.js" type="text/javascript"></script>
    <script src="~/Content/js/toastr.min.js"></script>
    <script src="~/Content/js/ui-toastr.js"></script>
    <script src="~/Content/js/Notifications.js"></script>
    <!-- Añadirlo después de la librería toastr -->
</body>
</html>
