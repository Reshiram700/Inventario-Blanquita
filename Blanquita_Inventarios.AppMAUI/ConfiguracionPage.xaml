<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Blanquita_Inventarios.AppMAUI.ConfiguracionPage"
             xmlns:viewmodel="clr-namespace:Blanquita_Inventarios.AppMAUI.ViewModels"
             x:DataType="viewmodel:ConfiguracionVM">

    <!-- ===== ESTILOS ===== -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Tarjeta -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Margin" Value="20,30"/>
                <Setter Property="BorderColor" Value="#DDDDDD"/>
                <Setter Property="BackgroundColor" Value="White"/>
            </Style>

            <!-- Botón principal -->
            <Style x:Key="MainButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="WidthRequest" Value="220"/>
                <Setter Property="HeightRequest" Value="55"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <!-- Título -->
            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#001968"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout>

        <!-- HEADER -->
        <StackLayout>

            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <ImageButton x:Name="btnBack"
                             Source="icon_back"
                             Command="{Binding RegresarCommand}"
                             WidthRequest="25"
                             HeightRequest="25"
                             Margin="25,15,0,0"/>
            </StackLayout>

            <Label Text="v 2.1"
                   TextColor="#e48e2c"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="End"
                   Margin="10,0"/>

            <Label Text="CONFIGURACIÓN"
                   Style="{StaticResource TitleLabel}"
                   Margin="0,10,0,0"/>
        </StackLayout>

        <!-- TARJETA -->
        <Frame Style="{StaticResource CardStyle}">
            <StackLayout Spacing="15">

                <Label Text="Inventario"
                       FontAttributes="Bold"
                       TextColor="#444444"/>

                <Picker x:Name="pkInventario"
                        Title="Selecciona un Inventario"
                        ItemsSource="{Binding ListaInventarios, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding Texto}"
                        SelectedItem="{Binding InventarioSeleccionado}"
                        SelectedIndex="{Binding IndexInventarioSeleccionado, Mode=TwoWay}"
                        BackgroundColor="#F4F6FA"
                        TextColor="Black">

                    <Picker.Behaviors>
                        <toolkit:EventToCommandBehavior
                            EventName="SelectedIndexChanged"
                            Command="{Binding SeleccionItemPickerCommand}" />
                    </Picker.Behaviors>

                </Picker>

            </StackLayout>
        </Frame>

        <!-- BOTÓN -->
        <StackLayout HorizontalOptions="Center">

            <Button x:Name="btnSeleccionar"
                    Text="SELECCIONAR"
                    Style="{StaticResource MainButton}"
                    Command="{Binding SeleccionarCommand}">

                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A2A88" Offset="0"/>
                        <GradientStop Color="#001968" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>

            </Button>

        </StackLayout>

    </VerticalStackLayout>
</ContentPage>
