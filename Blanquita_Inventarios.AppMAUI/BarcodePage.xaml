<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Blanquita_Inventarios.AppMAUI.BarcodePage"
             xmlns:viewmodel="clr-namespace:Blanquita_Inventarios.AppMAUI.ViewModels"
             x:DataType="viewmodel:BarcodeVM">
    <ScrollView>
        <VerticalStackLayout>
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <ImageButton x:Name="btnBack" Source="icon_back" Command="{Binding RegresarCommand}" 
                         WidthRequest="25" HeightRequest="25" Margin="25, 15"/>
            </StackLayout>
            <Label Text="Asegurese de enfocar el Código de Barras del Producto dentro de la zona de la cámara" 
               HorizontalOptions="FillAndExpand" FontSize="14" LineBreakMode="WordWrap" Margin="20, 0, 20, 40" />
            <zxing:CameraBarcodeReaderView x:Name="barcodeView"
                IsDetecting="True" IsTorchOn="False" VerticalOptions="CenterAndExpand"
                BarcodesDetected="CameraBarcodeReaderView_BarcodesDetected" Margin="0, 30"/>
            <Label x:Name="lblResultado" Text="{Binding DatoScan}" VerticalOptions="End" Margin="20, 20, 0, 0" />
            <Button Text="ACEPTAR" BackgroundColor="#001968" VerticalOptions="End"
            TextColor="#ffffff" Command="{Binding TomarCommand}" Margin="0, 10, 0, 0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>