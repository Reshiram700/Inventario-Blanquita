@model Blanquita_Inventarios.Site.ViewModels.AjustesVM

@{
    ViewBag.Title = "Ajustes de Entrada y Salida";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<style>
    .submit-progress-bg {
        background-color: lightgray;
        opacity: .5;
    }

    .submit-progress {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 640px;
        background-color: #2c3e50;
        color: white;
        -webkit-border-radius: 0.4em;
        -moz-border-radius: 0.4em;
        border-radius: 0.4em;
        box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -webkit-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -moz-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        padding: 25px 30px 30px 30px;
        z-index: 9999;
    }

        .submit-progress .progress-container {
            margin-top: 15px;
        }

        .submit-progress .progress {
            height: 30px;
            background-color: #34495e;
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 5px;
        }

        .submit-progress .progress-bar {
            background-color: #5cb85c;
            background-image: linear-gradient(to right, #5cb85c, #449d44);
            line-height: 30px;
            font-size: 14px;
            font-weight: bold;
            transition: width 0.5s ease;
            width: 0%;
        }

        .submit-progress .progress-text {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin-top: -5px;
            margin-bottom: 10px;
            color: #ecf0f1;
        }

        .submit-progress .progress-details {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 15px;
            font-size: 14px;
        }

            .submit-progress .progress-details .detail-row {
                display: flex;
                justify-content: space-between;
                padding: 5px 10px;
                background-color: rgba(255,255,255,0.05);
                border-radius: 4px;
            }

            .submit-progress .progress-details .detail-label {
                color: #bdc3c7;
                font-weight: normal;
            }

            .submit-progress .progress-details .detail-value {
                color: #ecf0f1;
                font-weight: bold;
            }

                .submit-progress .progress-details .detail-value.highlight {
                    color: #5cb85c;
                }

        .submit-progress .progress-title {
            font-size: 18px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 10px;
            color: #ecf0f1;
        }

        .submit-progress .progress-loader {
            display: none;
            text-align: center;
            margin-bottom: 10px;
        }

            .submit-progress .progress-loader i {
                margin-right: 0.5em;
            }

        .submit-progress .progress-bar.animated {
            background-image: linear-gradient(to right, #5cb85c 0%, #449d44 25%, #5cb85c 50%, #449d44 75%, #5cb85c 100%);
            background-size: 40px 40px;
            animation: progress-bar-stripes 2s linear infinite;
        }

    @@keyframes progress-bar-stripes {
        from {
            background-position: 40px 0;
        }

        to {
            background-position: 0 0;
        }
    }

    .submit-progress .progress-bar.success {
        background-color: #5cb85c;
        background-image: linear-gradient(to right, #5cb85c, #449d44);
    }

    .submit-progress .progress-bar.error {
        background-color: #d9534f;
        background-image: linear-gradient(to right, #d9534f, #c9302c);
    }

    .submit-progress .progress-spinner {
        display: none;
        text-align: center;
        margin-bottom: 10px;
    }

        .submit-progress .progress-spinner i {
            margin-right: 0.5em;
        }

    .btn-disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    #btnAplicar:disabled,
    #btnRegresar:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Ajustes de Entrada y Salida
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            @using (@Html.BeginForm("Index", "Ajustes", FormMethod.Post, new { id = "myForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" id="btnAplicar" class="btn blue-steel margin-right-10 margin-bottom-5">
                                            Aplicar Ajustes
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <button type="button" id="btnRegresar" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Home", "Home")'">
                                            Regresar
                                            <i class="fa fa-chevron-circle-left"></i>
                                        </button>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Inventario</label>
                                                    @Html.DropDownListFor(model => model.FiltroIdConfiguracion, new SelectList(Model.FiltroInventarios, "Valor", "Texto", Model.FiltroIdConfiguracion),
                                                        htmlAttributes: new { @class = "form-control edited", @id = "ddlFiltroInventarios" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Panel -->
        <div class="submit-progress hidden" id="progressPanel">
            <div class="progress-title">
                <i class="fa fa-cog fa-spin" id="progressSpinner"></i>
                <span id="progressTitle">Aplicando Ajustes</span>
            </div>

            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar" id="progressBar" role="progressbar" style="width: 0%;">
                        <span id="progressPercentage">0%</span>
                    </div>
                </div>
                <div class="progress-text" id="progressText">0%</div>
            </div>

            <div class="progress-details">
                <div class="detail-row">
                    <span class="detail-label">Etapa:</span>
                    <span class="detail-value" id="progressStage">Preparando...</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Artículos:</span>
                    <span class="detail-value" id="progressItems">0 / 0</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Tiempo:</span>
                    <span class="detail-value highlight" id="progressTime">00:00:00</span>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script>
        var progressInterval = null;
        var isProcessing = false;

        // Function to get progress status
        function getProgress() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetProgress", "Ajustes")',
                dataType: 'json',
                success: function (data) {
                    updateProgressUI(data);

                    // Check if process is finished
                    if (data.Finalizado) {
                        stopProgressPolling();
                        handleProcessComplete(data);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error getting progress:', error);
                    // Don't stop polling on error, try again
                }
            });
        }

        // Function to update UI with progress data
        function updateProgressUI(data) {
            // Update progress bar
            var percentage = data.Porcentaje || 0;
            $('#progressBar').css('width', percentage + '%');
            $('#progressBar span').text(percentage + '%');
            $('#progressText').text(percentage + '%');

            // Update stage
            $('#progressStage').text(data.Etapa || 'Preparando...');

            // Update items processed
            var processed = data.Procesados || 0;
            var total = data.Total || 0;
            $('#progressItems').text(processed + ' / ' + total + ' artículos');

            // Update time
            $('#progressTime').text(data.Tiempo || '00:00:00');

            // Update spinner visibility based on processing state
            if (data.EnProceso) {
                $('#progressSpinner').show();
            } else {
                $('#progressSpinner').hide();
            }

            // Change bar color if finished
            if (data.Finalizado) {
                if (data.Exitoso) {
                    $('#progressBar').removeClass('error animated').addClass('success');
                } else {
                    $('#progressBar').removeClass('success animated').addClass('error');
                }
            } else {
                $('#progressBar').removeClass('success error').addClass('animated');
            }
        }

        // Function to stop polling
        function stopProgressPolling() {
            if (progressInterval) {
                clearInterval(progressInterval);
                progressInterval = null;
            }
        }

        // Function to handle process completion
        function handleProcessComplete(data) {
            // Hide progress panel after a brief delay
            setTimeout(function() {
                $('#progressPanel').addClass('hidden');

                // Enable buttons
                $('#btnAplicar').prop('disabled', false);
                $('#btnRegresar').prop('disabled', false);

                isProcessing = false;

                // Show notification based on result
                if (data.Exitoso) {
                    ShowNotificacion('success', 'Proceso Completado', data.Mensaje || 'Ajustes aplicados correctamente', '4', '0');
                    // Reload page after success
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Index", "Ajustes")';
                    }, 1000);
                } else {
                    ShowNotificacion('error', 'Error', data.Mensaje || 'Ocurrió un error al aplicar los ajustes', '4', '0');
                    // Reload page after error too, to show any error state
                    setTimeout(function() {
                        window.location.href = '@Url.Action("Index", "Ajustes")';
                    }, 1500);
                }
            }, 1000);
        }

        // Form submission handler
        $("form").submit(function (event) {
            event.preventDefault();

            // Prevent multiple submissions
            if (isProcessing) {
                ShowNotificacion('warning', 'Proceso en ejecución', 'Ya hay un proceso de ajustes en ejecución', '4', '0');
                return false;
            }

            // Disable buttons
            $("#btnAplicar").prop('disabled', true);
            $("#btnRegresar").prop('disabled', true);

            // Show and reset progress panel
            $('#progressPanel').removeClass('hidden');
            $('#progressBar').css('width', '0%');
            $('#progressBar span').text('0%');
            $('#progressText').text('0%');
            $('#progressStage').text('Iniciando proceso...');
            $('#progressItems').text('0 / 0 artículos');
            $('#progressTime').text('00:00:00');
            $('#progressBar').removeClass('success error').addClass('animated');
            $('#progressSpinner').show();

            // Start AJAX request
            $.ajax({
                type: $('#myForm').attr('method'),
                url: $('#myForm').attr('action'),
                data: $('#myForm').serialize(),
                accept: 'application/json',
                dataType: "json",
                error: function (xhr, status, error) {
                    // Hide progress and show error
                    $('#progressPanel').addClass('hidden');
                    $("#btnAplicar").prop('disabled', false);
                    $("#btnRegresar").prop('disabled', false);
                    isProcessing = false;

                    // Stop polling if any
                    stopProgressPolling();

                    // Show error notification
                    var errorMsg = error && error.statusText ? error.statusText : 'Error al iniciar el proceso';
                    ShowNotificacion("error", "Error", errorMsg, "4", "0");
                },
                success: function (response) {
                    if (response.ExecutionOK) {
                        isProcessing = true;
                        // Start polling for progress
                        if (progressInterval) {
                            clearInterval(progressInterval);
                        }
                        progressInterval = setInterval(getProgress, 1000);
                        // Immediate first call
                        getProgress();
                    } else {
                        // Process didn't start
                        $('#progressPanel').addClass('hidden');
                        $("#btnAplicar").prop('disabled', false);
                        $("#btnRegresar").prop('disabled', false);
                        isProcessing = false;
                        ShowNotificacion("error", "Error", response.Message || "No se pudo iniciar el proceso", "4", "0");
                    }
                }
            });
        });

        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: false,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"] // change per page values here
                ],
                lengthChange: false, //Oculta el listado de elementos por pagina
                // set the initial value
                pageLength: 25,
                info: false
            });
        });
    </script>
}