@model Blanquita_Inventarios.Site.ViewModels.Avance_MarbetesVM

@{
    ViewBag.Title = "Marbetes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Avance por Marbete
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            @using (@Html.BeginForm("Marbetes", "Monitor", FormMethod.Post, new { id = "myForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-success margin-right-10 margin-bottom-5">
                                            Refresh
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <button type="button" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Home", "Home")'">
                                            Regresar
                                            <i class="fa fa-chevron-circle-left"></i>
                                        </button>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Nombre del Inventario General</label>
                                                    @Html.DropDownListFor(model => model.FiltroIdConfiguracion, new SelectList(Model.FiltroInventarios, "Valor", "Texto", Model.FiltroIdConfiguracion),
                                                        htmlAttributes: new { @class = "form-control edited", @id = "ddlFiltroInventarios", @onchange = "Get_Zonas(this.value);" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Zona</label>
                                                    @Html.DropDownListFor(model => model.FiltroIdZona, new SelectList(Model.FiltroZonas, "Valor", "Texto", Model.FiltroIdZona),
                                                        htmlAttributes: new { @class = "form-control edited", @id = "ddlFiltroZona" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Marbete</label>
                                                    @Html.TextBoxFor(m => m.FiltroMarbete, htmlAttributes: new { @class = "form-control form-control-solid placeholder-no-fix", @placeholder = "Marbete", @autocomplete = "off" })
                                                </div>
                                            </div>
                                        </div>
                                        <br />

                                        <div class="panel panel-default">
                                            <div class="panel-body">
                                                <div class="row">
                                                    <table style="margin-left: 20px;">
                                                        <tr>
                                                            <td rowspan="2"><img src="~/Content/img/logo.png" /></td>
                                                            <td rowspan="2">
                                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                            </td>
                                                            <td colspan="3">
                                                                <h3 style="letter-spacing: 2px;">Avance del @String.Format("{0:#,##0.00}", Model.Avance.Avance) % monto $ @String.Format("{0:#,##0.00}", Model.Avance.Monto) Tiempo @Model.Avance.Tiempo</h3>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <b>Nombre del Inventario:</b> @Model.Avance.Inventario
                                                            </td>
                                                            <td>
                                                                &nbsp;&nbsp;&nbsp;
                                                            </td>
                                                            <td>
                                                                <b>Almacén:</b> @Model.Avance.Almacen
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>

                                                <table class="table table-bordered">
                                                    <thead>
                                                        <tr class="bg-light headerCustom">
                                                            <th style="text-align: center;">
                                                                Almacén
                                                            </th>
                                                            <th style="text-align: center;">
                                                                Zona
                                                            </th>
                                                            <th style="text-align: center;">
                                                                Marbete
                                                            </th>
                                                            <th style="text-align: center;">
                                                                Estatus
                                                            </th>
                                                            <th style="text-align: center;">
                                                                Importe
                                                            </th>
                                                            <th style="text-align: center;">
                                                                Tiempo
                                                            </th>
                                                            <th style="text-align: center;">
                                                                Nombre
                                                            </th>
                                                            <th style="text-align: center;">Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.Avance.Listado != null && Model.Avance.Listado.Count > 0)
                                                        {
                                                            foreach (var item in Model.Avance.Listado)
                                                            {
                                                                <tr class="@item.Estatus">
                                                                    <td>
                                                                        @Html.DisplayFor(modelItem => item.Almacen)
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(modelItem => item.Zona)
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(modelItem => item.Marbete)
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(modelItem => item.Estatus)
                                                                    </td>
                                                                    <td>
                                                                        @(String.Format("{0:$ #,##0.00}", item.Importe))
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(modelItem => item.Tiempo)
                                                                    </td>
                                                                    <td>
                                                                        @Html.DisplayFor(modelItem => item.Nombre)
                                                                    </td>
                                                                    <td align="center">
                                                                        <button class="btn btn-xs green-jungle btn-detalles" type="button"
                                                                                onclick="Ver_Detalles(@Model.FiltroIdConfiguracion, @item.Marbete)">
                                                                            <i class="fa fa-edit"></i>
                                                                            &nbsp;Detalle de Marbete
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script>
        function Get_Zonas(valor) {
            var url = '@Url.Action("Get_ZonasByConfiguracion", "Monitor")';

            $.ajax({
                url: url,
                data: { idConfiguracion: valor },
                cache: false,
                type: "POST",
                success: function (data) {
                    var markup = "";
                    for (var x = 0; x < data.length; x++) {
                        markup += "<option value=" + data[x].Valor + ">" + data[x].Texto + "</option>";
                    }

                    $("#ddlFiltroZona").html(markup).show();
                },
                error: function (reponse) {
                    alert("error : " + reponse);
                }
            });
        }

        function Ver_Detalles(idConfiguracion, marbete) {
            var data = new FormData();
            data.append("idConfiguracion", idConfiguracion);
            data.append("marbete", marbete);

            var url = '@Url.Action("Ver_Marbete", "Monitor")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        var urlFormato = '@Url.Action("Marbete", "Monitor")';
                        window.location.href = urlFormato;
                    }
                    else {
                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: false,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"] // change per page values here
                ],
                lengthChange: false, //Oculta el listado de elementos por pagina
                // set the initial value
                pageLength: 25,
                info: false
            });
        });
    </script>
}

