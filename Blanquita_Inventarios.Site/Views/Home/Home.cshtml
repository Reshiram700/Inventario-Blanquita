                        <span class="cbp-filter-counter">3</span>
                    </div>
                    <div data-filter=".monitor" class="cbp-filter-item @(idPerfil == 3 || idPerfil == 4 ? "" : "hidden" )">
                        <i class="fa fa-bar-chart"></i> Monitor de Avances
                        <span class="cbp-filter-counter">3</span>
                    </div>
                    <div data-filter=".diferencias" class="cbp-filter-item @(idPerfil == 3 || idPerfil == 4 ? "" : "hidden" )">
                        <i class="fa fa-arrows-h"></i> Monitor de Diferencias
                        <span class="cbp-filter-counter">6</span>
                    </div>
                    <div data-filter=".operaciones" class="cbp-filter-item @(idPerfil == 3 || idPerfil == 4 ? "" : "hidden" )">
                        <i class="fa fa-play-circle"></i> Operaciones
                        <span class="cbp-filter-counter">2</span>
                    </div>
