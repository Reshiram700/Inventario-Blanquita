@model Blanquita_Inventarios.Site.ViewModels.Listado_ZonasVM

@{
    ViewBag.Title = "Admninistrador de Zonas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<link href="~/Content/others/daterangepicker/daterangepicker.css" rel="stylesheet" />

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Administrador de Zonas
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            @using (@Html.BeginForm("Zonas", "Configuraciones", FormMethod.Post, new { id = "myForm" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.IdConfiguracion, htmlAttributes: new { @id = "hdfIdConfiguracion" })
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="button" class="btn btn-primary margin-right-10 margin-bottom-5" onclick="location.href='@Url.Action("CreateZona", "Configuraciones", new { idConfiguracion = Model.IdConfiguracion })'">
                                            Agregar
                                            <i class="fa fa-plus"></i>
                                        </button>
                                        <button type="submit" class="btn btn-success margin-right-10 margin-bottom-5">
                                            Buscar
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <button type="button" value="Restablecer" class="btn grey margin-right-10 margin-bottom-5" onclick="location.href='@Url.Action("RestablecerZonas", "Configuraciones", new { id = Model.IdConfiguracion})'">
                                            Restablecer
                                            <i class="fa fa-undo"></i>
                                        </button>
                                        <button type="button" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Index", "Configuraciones")'">
                                            Regresar
                                            <i class="fa fa-chevron-circle-left"></i>
                                        </button>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Fecha de Registro</label>
                                                    @Html.TextBoxFor(m => m.FiltroFechas, htmlAttributes: new { @class = "form-control form-control-solid placeholder-no-fix", @placeholder = "Fecha de Registro", @autocomplete = "off", @id = "txtFiFechas" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Zona</label>
                                                    @Html.TextBoxFor(m => m.FiltroZona, htmlAttributes: new { @class = "form-control form-control-solid placeholder-no-fix", @placeholder = "Zona", @autocomplete = "off" })
                                                </div>
                                            </div>
                                        </div>

                                        <table class="table table-bordered mb-0 table-sm dataTable-simple tabla-datos">
                                            <thead>
                                                <tr class="bg-light headerCustom">
                                                    <th>
                                                        <input name="control" value="ID"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Fecha/Hora Registro"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Zona"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Marbete Inicial"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th>
                                                        <input name="control" value="Marbete Final"
                                                               class="btn headerCustom" />
                                                    </th>
                                                    <th><div style="font-size:14px!important;text-align:center"></div></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Listado != null && Model.Listado.Count > 0)
                                                {
                                                    foreach (var item in Model.Listado)
                                                    {
                                                        <tr class="@(item.MarbetesCreados == true ? "Cerrado" : "")">
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.IdZona)
                                                            </td>
                                                            <td>
                                                                @(String.Format("{0:dd/MM/yyyy HH:mm}", item.FechaRegistro))
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Zona)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.MarbeteInicial)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.MarbeteFinal)
                                                            </td>
                                                            <td align="center">

                                                                <button class="btn btn-xs green-jungle btn-detalles" type="button"
                                                                        onclick="CrearMarbetes(@item.IdZona, @Model.IdConfiguracion)">
                                                                    <i class="fa fa-edit"></i>
                                                                    &nbsp;Crear Marbetes
                                                                </button>
                                                                <button class="btn btn-xs green-jungle btn-detalles" type="button"
                                                                        onclick="EliminarMarbetes(@item.IdZona, @Model.IdConfiguracion);">
                                                                    <i class="fa fa-edit"></i>
                                                                    &nbsp;Borrar Marbetes
                                                                </button>
                                                                <button class="btn btn-xs red" type="button"
                                                                        onclick="EliminarZona(@item.IdZona, @Model.IdConfiguracion);">
                                                                    <i class="fa fa-times"></i>
                                                                    &nbsp;Eliminar
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script src="~/Content/others/daterangepicker/moment.min.js"></script>
    <script src="~/Content/others/daterangepicker/daterangepicker.js"></script>

    <script>
        function CrearMarbetes(idZona, idConfiguracion) {
            var data = new FormData();
            data.append("idZona", idZona);

            var url = '@Url.Action("CreateMarbetes", "Configuraciones")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        ShowNotificacion("success", "", response.Message, "4", "0");
                        var urlLoad = '@Url.Action("Zonas", "Configuraciones")';
                        window.location.href = urlLoad;
                    }
                    else {
                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        function EliminarMarbetes(idZona, idConfiguracion) {
            var data = new FormData();
            data.append("idZona", idZona);

            var url = '@Url.Action("DeleteMarbetes", "Configuraciones")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        ShowNotificacion("success", "", response.Message, "4", "0");
                    }
                    else {
                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        function EliminarZona(idZona, idConfiguracion) {
            var data = new FormData();
            data.append("idZona", idZona);

            var url = '@Url.Action("DeleteZona", "Configuraciones")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        ShowNotificacion("success", "", response.Message, "4", "0");
                        var urlLoad = '@Url.Action("Zonas", "Configuraciones")';
                        window.location.href = urlLoad;
                    }
                    else {
                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }


        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: false,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"] // change per page values here
                ],
                lengthChange: false, //Oculta el listado de elementos por pagina
                // set the initial value
                pageLength: 25,
                info: false
            });

            $('input[id*="txtFiFecha"]').daterangepicker({
                locale: {
                    cancelLabel: "Limpiar",
                    format: "DD/MM/YYYY",
                    separator: " - ",
                    applyLabel: "APLICAR",
                    cancelLabel: "CANCELAR",
                    fromLabel: "De",
                    toLabel: "A",
                    customRangeLabel: "Personalizar...",
                    weekLabel: "W",
                    daysOfWeek: [
                        "Do",
                        "Lu",
                        "Ma",
                        "Mi",
                        "Ju",
                        "Vi",
                        "Sa"
                    ],
                    monthNames: [
                        "Enero",
                        "Febrero",
                        "Marzo",
                        "Abril",
                        "Mayo",
                        "Junio",
                        "Julio",
                        "Agosto",
                        "Septiembre",
                        "Octubre",
                        "Noviembre",
                        "Diciembre"
                    ],
                    firstDay: 1
                }
            });
        });
    </script>
}


