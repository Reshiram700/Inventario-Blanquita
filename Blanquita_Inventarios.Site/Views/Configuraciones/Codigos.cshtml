@model Blanquita_Inventarios.Site.ViewModels.Listado_CodigosVM

@{
    ViewBag.Title = "Generador de Códigos de Autorización";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Generador de Códigos de Autorización
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            <div class="row">
                                @Html.HiddenFor(model => model.IdConfiguracion, htmlAttributes: new { @id = "hdfIdConfiguracion" })
                                <div class="col-md-12">
                                    <button type="button" class="btn btn-primary margin-right-10 margin-bottom-5" onclick="GenerarCodigo(@Model.IdConfiguracion)">
                                        Generar
                                        <i class="fa fa-plus"></i>
                                    </button>
                                    <button type="button" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Index", "Configuraciones")'">
                                        Regresar
                                        <i class="fa fa-chevron-circle-left"></i>
                                    </button>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12">
                                    <table class="table table-bordered mb-0 table-sm dataTable-simple tabla-datos">
                                        <thead>
                                            <tr class="bg-light headerCustom">
                                                <th>
                                                    <input name="control" value="Código de Autorización"
                                                           class="btn headerCustom" />
                                                </th>
                                                <th>
                                                    <input name="control" value="Fecha/Hora Generación"
                                                           class="btn headerCustom" />
                                                </th>
                                                <th>
                                                    <input name="control" value="Usuario Genero"
                                                           class="btn headerCustom" />
                                                </th>
                                                <th>
                                                    <input name="control" value="Usuario Utilizo"
                                                           class="btn headerCustom" />
                                                </th>
                                                <th>
                                                    <input name="control" value="Acción en la que se utilizo"
                                                           class="btn headerCustom" />
                                                </th>
                                                <th>
                                                    <input name="control" value="Estatus"
                                                           class="btn headerCustom" />
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Listado != null && Model.Listado.Count > 0)
                                            {
                                                foreach (var item in Model.Listado)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Codigo)
                                                        </td>
                                                        <td>
                                                            @(String.Format("{0:dd/MM/yyyy HH:mm}", item.FechaGeneracion))
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.UsuarioGenero)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.UsuarioUtilizo)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Accion)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Estatus)
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script>
        function GenerarCodigo(idConfiguracion) {
            var data = new FormData();
            data.append("idConfiguracion", idConfiguracion);

            var url = '@Url.Action("GenerarCodigo", "Configuraciones")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        var urlLoad = '@Url.Action("Codigos", "Configuraciones")';                        
                        window.location.href = urlLoad;
                    }
                    else {
                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: false,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"] // change per page values here
                ],
                lengthChange: false, //Oculta el listado de elementos por pagina
                // set the initial value
                pageLength: 25,
                info: false
            });
        });
    </script>
}

