@model Blanquita_Inventarios.Site.ViewModels.Diferencias_ConteoUnoVM

@{
    ViewBag.Title = "Diferencias en Conteo 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<style>
    .submit-progress-bg {
        background-color: lightgray;
        opacity: .5;
    }

    .submit-progress {
        position: fixed;
        top: 50%;
        left: 45%;
        height: 6em;
        padding-top: 2.3em;
        /* The following rules are the
    ones most likely to change */
        width: 20em;
        /* Set 'margin-left' to a negative number
    that is 1/2 of 'width' */
        margin-left: -10em;
        padding-left: 2.1em;
        background-color: black;
        color: white;
        -webkit-border-radius: 0.4em;
        -moz-border-radius: 0.4em;
        border-radius: 0.4em;
        box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -webkit-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -moz-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
    }

    .submit-progress {
        padding-top: 2em;
        width: 640px;
    }

        .submit-progress i {
            margin-right: 0.5em;
        }
</style>

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Diferencias Conteo 1
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            @using (@Html.BeginForm("ConteoUno", "MonitorDiferencias", FormMethod.Post, new { id = "myForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" id="btnRefresh" class="btn btn-success margin-right-10 margin-bottom-5">
                                            Refresh
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <button type="button" id="btnExcel" class="btn green-jungle margin-bottom-5" onclick="ExportExcel()">
                                            Excel
                                            <i class="fa fa-file-excel-o"></i>
                                        </button>
                                        <button type="button" id="btnReporte1" class="btn blue-steel margin-bottom-5" onclick="Modal_Varianza(@Model.FiltroIdConfiguracion);">
                                            Reporte (Diferencia + Categoría)
                                            <i class="fa fa-file-text-o"></i>
                                        </button>
                                        <button type="button" id="btnReporte2" class="btn blue-steel margin-bottom-5" onclick="Modal_ReporteZona(@Model.FiltroIdConfiguracion);">
                                            Reporte (Diferencia + Zona)
                                            <i class="fa fa-file-text-o"></i>
                                        </button>
                                        <button type="button" id="btnRegresar" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Home", "Home")'">
                                            Regresar
                                            <i class="fa fa-chevron-circle-left"></i>
                                        </button>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Inventario</label>
                                                    @Html.DropDownListFor(model => model.FiltroIdConfiguracion, new SelectList(Model.FiltroInventarios, "Valor", "Texto", Model.FiltroIdConfiguracion),
                                                        htmlAttributes: new { @class = "form-control edited", @id = "ddlFiltroInventarios" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Buscar</label>
                                                    @Html.TextBoxFor(m => m.FiltroBusca, htmlAttributes: new { @class = "form-control form-control-solid placeholder-no-fix", @placeholder = "", @autocomplete = "off" })
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">ItmsGrpNam</label>
                                                    @Html.DropDownListFor(model => model.FiltroValorItmsGrpNam, new SelectList(Model.FiltroItmsGrpNam, "Valor", "Texto", Model.FiltroValorItmsGrpNam),
                                                        htmlAttributes: new { @class = "form-control edited", @id = "ddlFiltroCategorias" })
                                                </div>
                                            </div>
                                        </div>
                                        <br />
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr class="bg-light headerCustom">
                                                    <th>
                                                        WhsCode
                                                    </th>
                                                    <th>
                                                        ItmsGrpNam
                                                    </th>
                                                    <th>
                                                        ItemCode
                                                    </th>
                                                    <th>
                                                        ItemName
                                                    </th>
                                                    <th>
                                                        UOM1
                                                    </th>
                                                    <th>
                                                        Onhand
                                                    </th>
                                                    <th>
                                                        Por Procesar
                                                    </th>
                                                    <th>
                                                        Contado
                                                    </th>
                                                    <th>
                                                        Dif Pesos Neto
                                                    </th>
                                                    <th>
                                                        Marbetes
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Listado != null && Model.Listado.Count > 0)
                                                {
                                                    foreach (var item in Model.Listado)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.WhsCode)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ItmsGrpNam)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ItemCode)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ItemName)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Uom)
                                                            </td>
                                                            <td>
                                                                @(String.Format("{0:#,##0.00}", item.Onhand))
                                                            </td>
                                                            <td>
                                                                @(String.Format("{0:#,##0.00}", item.PorProcesar))
                                                            </td>
                                                            <td>
                                                                @(String.Format("{0:#,##0.00}", item.Contado))
                                                            </td>
                                                            <td>
                                                                @(String.Format("{0:$ #,##0.00}", item.DifPesoNeto))
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Marbetes)
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div id="modalVarianza" class="modal fade" tabindex="-1" role="dialog">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <input type="hidden" id="hdfIdConfiguracion" value="0" />
                                                        <div class="form-group">
                                                            <label>Ingrese el monto de la varianza $</label>
                                                            <input type="number" class="form-control" id="txtMonto">
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Categoría</label>
                                                            @Html.DropDownListFor(model => model.FiltroValorItmsGrpNam2, new SelectList(Model.FiltroItmsGrpNam2, "Valor", "Texto", Model.FiltroValorItmsGrpNam2),
                                                                htmlAttributes: new { @class = "form-control", @id = "ddlFiltroCategoriasReporte" })
                                                        </div>
                                                        <br />
                                                        <button type="button" id="btnProcesar1" class="btn btn-primary" onclick="Procesar_Formato();">Ver Reporte</button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                                            </div>
                                        </div><!-- /.modal-content -->
                                    </div><!-- /.modal-dialog -->
                                </div><!-- /.modal -->


                                <div id="modalZonas" class="modal fade" tabindex="-1" role="dialog">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <input type="hidden" id="hdfIdConfiguracionZonas" value="0" />
                                                        <div class="form-group">
                                                            <label>Ingrese el monto de la varianza $</label>
                                                            <input type="number" class="form-control" id="txtZonaMonto">
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Zona</label>
                                                            @Html.DropDownListFor(model => model.FiltroIdZonaReporte, new SelectList(Model.FiltroZonasReporte, "Valor", "Texto", Model.FiltroIdZonaReporte),
                                                                htmlAttributes: new { @class = "form-control", @id = "ddlFiltroZonasReporte" })
                                                        </div>
                                                        <br />
                                                        <button type="button" id="btnProcesar2" class="btn btn-primary" onclick="Procesar_ReporteZona();">Ver Reporte</button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                                            </div>
                                        </div><!-- /.modal-content -->
                                    </div><!-- /.modal-dialog -->
                                </div><!-- /.modal -->
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="submit-progress hidden">
            <i class="fa fa-2x fa-spinner fa-spin"></i>
            <label>Espere un momento mientras se procesa la petición...</label>
        </div>

    </div>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script>
        function ExportExcel() {
            var url = '@Url.Action("ExcelConteoUno", "MonitorDiferencias")';
            $.ajax({
                type: "POST",
                url: url,
                processData: false, //remember to set processData and ContentType to false, otherwise you may get an error
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        window.location.href = "../Documentos/Descargas/" + response.Data;
                    }
                    else {
                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        function Modal_Varianza(idConfiguracion) {
            if (idConfiguracion > 0) {
                $('#hdfIdConfiguracion').val(idConfiguracion);
                $('#txtMonto').val("0");
                $('#ddlFiltroCategoriasReporte').val("");
                $('#modalVarianza').modal('show');
            }
            else {
                ShowNotificacion("error", "Error", "Seleccione primeramente un Inventario", "4", "0");
            }
        }

        function Procesar_Formato() {
            $("#btnRefresh").attr('disabled', 'disabled');
            $("#btnExcel").attr('disabled', 'disabled');
            $("#btnReporte1").attr('disabled', 'disabled');
            $("#btnReporte2").attr('disabled', 'disabled');
            $("#btnRegresar").attr('disabled', 'disabled');
            $("#btnProcesar1").attr('disabled', 'disabled');
            $("#btnProcesar2").attr('disabled', 'disabled');
            $(".submit-progress").removeClass("hidden");

            var idConfiguracion = $('#hdfIdConfiguracion').val();
            var monto = $('#txtMonto').val();
            var categoria = $('#ddlFiltroCategoriasReporte').val();

            if (categoria == "") {
                ShowNotificacion("error", "Error", "Seleccione una Categoría", "4", "0");

                $(".submit-progress").removeClass("hidden").addClass("hidden");
                $("#btnRefresh").removeAttr('disabled');
                $("#btnExcel").removeAttr('disabled');
                $("#btnReporte1").removeAttr('disabled');
                $("#btnReporte2").removeAttr('disabled');
                $("#btnRegresar").removeAttr('disabled');
                $("#btnProcesar1").removeAttr('disabled');
                $("#btnProcesar2").removeAttr('disabled');

                return false;
            }

            var data = new FormData();
            data.append("idConfiguracion", idConfiguracion);
            data.append("monto", monto);
            data.append("categoria", categoria);

            var url = '@Url.Action("ProcesarFormato", "MonitorDiferencias")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        var urlFormato = '@Url.Action("Reporte", "MonitorDiferencias")';
                        window.location.href = urlFormato;
                    }
                    else {
                        $(".submit-progress").removeClass("hidden").addClass("hidden");
                        $("#btnRefresh").removeAttr('disabled');
                        $("#btnExcel").removeAttr('disabled');
                        $("#btnReporte1").removeAttr('disabled');
                        $("#btnReporte2").removeAttr('disabled');
                        $("#btnRegresar").removeAttr('disabled');
                        $("#btnProcesar1").removeAttr('disabled');
                        $("#btnProcesar2").removeAttr('disabled');

                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    $(".submit-progress").removeClass("hidden").addClass("hidden");
                    $("#btnRefresh").removeAttr('disabled');
                    $("#btnExcel").removeAttr('disabled');
                    $("#btnReporte1").removeAttr('disabled');
                    $("#btnReporte2").removeAttr('disabled');
                    $("#btnRegresar").removeAttr('disabled');
                    $("#btnProcesar1").removeAttr('disabled');
                    $("#btnProcesar2").removeAttr('disabled');

                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        function Modal_ReporteZona(idConfiguracion) {
            if (idConfiguracion > 0) {
                $('#hdfIdConfiguracionZonas').val(idConfiguracion);
                $('#txtZonaMonto').val("0");
                $('#ddlFiltroZonasReporte').val("0");
                $('#modalZonas').modal('show');
            }
            else {
                ShowNotificacion("error", "Error", "Seleccione primeramente un Inventario", "4", "0");
            }
        }

        function Procesar_ReporteZona() {
            $("#btnRefresh").attr('disabled', 'disabled');
            $("#btnExcel").attr('disabled', 'disabled');
            $("#btnReporte1").attr('disabled', 'disabled');
            $("#btnReporte2").attr('disabled', 'disabled');
            $("#btnRegresar").attr('disabled', 'disabled');
            $("#btnProcesar1").attr('disabled', 'disabled');
            $("#btnProcesar2").attr('disabled', 'disabled');
            $(".submit-progress").removeClass("hidden");

            var idConfiguracion = $('#hdfIdConfiguracionZonas').val();
            var monto = $('#txtZonaMonto').val();
            var idZona = $('#ddlFiltroZonasReporte').val();

            if (idZona == 0) {
                $(".submit-progress").removeClass("hidden").addClass("hidden");
                $("#btnRefresh").removeAttr('disabled');
                $("#btnExcel").removeAttr('disabled');
                $("#btnReporte1").removeAttr('disabled');
                $("#btnReporte2").removeAttr('disabled');
                $("#btnRegresar").removeAttr('disabled');
                $("#btnProcesar1").removeAttr('disabled');
                $("#btnProcesar2").removeAttr('disabled');

                ShowNotificacion("error", "Error", "Seleccione una Zona", "4", "0");
                return false;
            }

            var data = new FormData();
            data.append("idConfiguracion", idConfiguracion);
            data.append("monto", monto);
            data.append("idZona", idZona);

            var url = '@Url.Action("ProcesarFormatoZonas", "MonitorDiferencias")';
            $.ajax({
                type: "POST",
                data: data,
                url: url,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.ExecutionOK == true) {
                        var urlFormato = '@Url.Action("ReporteZonas", "MonitorDiferencias")';
                        window.location.href = urlFormato;
                    }
                    else {
                        $(".submit-progress").removeClass("hidden").addClass("hidden");
                        $("#btnRefresh").removeAttr('disabled');
                        $("#btnExcel").removeAttr('disabled');
                        $("#btnReporte1").removeAttr('disabled');
                        $("#btnReporte2").removeAttr('disabled');
                        $("#btnRegresar").removeAttr('disabled');
                        $("#btnProcesar1").removeAttr('disabled');
                        $("#btnProcesar2").removeAttr('disabled');

                        ShowNotificacion("error", "Error", response.Message, "4", "0");
                    }
                },
                error: function (err) {
                    $(".submit-progress").removeClass("hidden").addClass("hidden");
                    $("#btnRefresh").removeAttr('disabled');
                    $("#btnExcel").removeAttr('disabled');
                    $("#btnReporte1").removeAttr('disabled');
                    $("#btnReporte2").removeAttr('disabled');
                    $("#btnRegresar").removeAttr('disabled');
                    $("#btnProcesar1").removeAttr('disabled');
                    $("#btnProcesar2").removeAttr('disabled');

                    ShowNotificacion("error", "Error", err.statusText, "4", "0");
                }
            });
        }

        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: false,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"] // change per page values here
                ],
                lengthChange: false, //Oculta el listado de elementos por pagina
                // set the initial value
                pageLength: 25,
                info: false
            });
        });
    </script>
}

