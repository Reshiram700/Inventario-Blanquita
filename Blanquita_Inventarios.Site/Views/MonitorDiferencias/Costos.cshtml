@model Blanquita_Inventarios.Site.ViewModels.Diferencias_CostosVM

@{
    ViewBag.Title = "Monitor de Diferencias. Costo Cero Inactivos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/datatables.min.css" rel="stylesheet" />
<link href="~/Content/css/datatables.bootstrap.css" rel="stylesheet" />

<style>
    .submit-progress-bg {
        background-color: lightgray;
        opacity: .5;
    }

    .submit-progress {
        position: fixed;
        top: 50%;
        left: 45%;
        height: 6em;
        padding-top: 2.3em;
        width: 20em;
        margin-left: -10em;
        padding-left: 2.1em;
        background-color: black;
        color: white;
        -webkit-border-radius: 0.4em;
        -moz-border-radius: 0.4em;
        border-radius: 0.4em;
        box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -webkit-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
        -moz-box-shadow: 0.4em 0.4em rgba(0,0,0,0.6);
    }

    .submit-progress {
        padding-top: 2em;
        width: 640px;
    }

        .submit-progress i {
            margin-right: 0.5em;
        }
</style>

<div class="page-content-wrapper">
    <!-- BEGIN CONTENT BODY -->
    <div class="page-content">
        <!-- BEGIN PAGE HEADER-->
        <h1 class="page-title">
            Diferencias. Costos Cero Inactivos
        </h1>
        <!-- END PAGE HEADER-->
        <div class="row widget-row">
            <div class="col-md-12">
                <div class="portlet box dark">
                    <div class="portlet-title">
                        <div class="caption">

                        </div>
                        <div class="actions">
                            <a class="btn btn-circle btn-icon-only btn-default fullscreen" href="javascript:;" data-original-title="" title=""></a>
                        </div>
                    </div>
                    <div class="portlet-body">
                        <div class="table-toolbar">
                            @using (@Html.BeginForm("Costos", "MonitorDiferencias", FormMethod.Post, new { id = "myForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-12">
                                        <button type="submit" class="btn btn-success margin-right-10 margin-bottom-5">
                                            Refresh
                                            <i class="fa fa-search"></i>
                                        </button>
                                        <!-- ===== NUEVO BOTÓN EXCEL ===== -->
                                        <button type="button" id="btnExcel" class="btn green-jungle margin-bottom-5" onclick="ExportExcel()">
                                            Excel
                                            <i class="fa fa-file-excel-o"></i>
                                        </button>
                                        <button type="button" class="btn btn-default margin-bottom-5" onclick="location.href='@Url.Action("Home", "Home")'">
                                            Regresar
                                            <i class="fa fa-chevron-circle-left"></i>
                                        </button>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group form-md-line-input form-md-floating-label has-info" style="margin-bottom: 0px !important; padding-top: 0px!important;">
                                                    <label style="font-size: small;">Inventario</label>
                                                    @Html.DropDownListFor(model => model.FiltroIdConfiguracion, new SelectList(Model.FiltroInventarios, "Valor", "Texto", Model.FiltroIdConfiguracion),
                                                        htmlAttributes: new { @class = "form-control edited", @id = "ddlFiltroInventarios" })
                                                </div>
                                            </div>
                                        </div>

                                        <table id="tablaCostosCero" class="table table-bordered mb-0 table-sm dataTable-simple tabla-datos">
                                            <thead>
                                                <tr class="bg-light headerCustom">
                                                    <th>Código</th>
                                                    <th>Descripción del Artículo</th>
                                                    <th>Estatus</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyCostosCero">
                                                @if (Model.Listado != null && Model.Listado.Count > 0)
                                                {
                                                    foreach (var item in Model.Listado)
                                                    {
                                                        <tr>
                                                            <td>@Html.DisplayFor(modelItem => item.ItemCode)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                                                            <td>@Html.DisplayFor(modelItem => item.Estatus)</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== INDICADOR DE CARGA PARA EXCEL ===== -->
<div id="excelProgress" class="submit-progress hidden">
    <i class="fa fa-2x fa-spinner fa-spin"></i>
    <label>Generando archivo Excel...</label>
</div>

@section scripts
{
    <script src="~/Content/js/datatables.js"></script>
    <script src="~/Content/js/datatables.min.js"></script>
    <script src="~/Content/js/datatables.bootstrap.js"></script>

    <script>
        // ===== FUNCIÓN PARA EXPORTAR A EXCEL =====
    function ExportExcel() {
        // Deshabilitar botón y mostrar progreso
        $("#btnExcel").attr('disabled', 'disabled');
        $("#btnExcel").html('<i class="fa fa-spinner fa-spin"></i> Generando...');
        $("#excelProgress").removeClass("hidden");

        // Llamar al controlador para generar el Excel (sin enviar datos)
        $.ajax({
            url: '@Url.Action("ExcelCostosCero", "MonitorDiferencias")',
            type: "POST",
            success: function (response) {
                if (response.success) {
                    // Descargar el archivo
                    window.location.href = response.url;
                    ShowNotificacion("success", "Información", "El archivo se ha generado correctamente.", "4", "0");
                } else {
                    ShowNotificacion("error", "Error", response.message, "4", "0");
                }
            },
            error: function (xhr, status, error) {
                ShowNotificacion("error", "Error", "No se pudo generar el archivo: " + error, "4", "0");
            },
            complete: function () {
                // Restaurar botón
                $("#btnExcel").removeAttr('disabled');
                $("#btnExcel").html('Excel <i class="fa fa-file-excel-o"></i>');
                $("#excelProgress").addClass("hidden");
            }
        });
    }

        // ===== FUNCIÓN ALTERNATIVA: Exportar directamente desde la tabla (más rápida) =====
        function ExportExcelDirecto() {
            // Obtener los datos de la tabla
            var datos = [];
            var headers = [];

            // Obtener encabezados
            $('#tablaCostosCero thead th').each(function() {
                headers.push($(this).text().trim());
            });

            // Obtener datos
            $('#tbodyCostosCero tr').each(function() {
                var row = $(this);
                var fila = {};
                row.find('td').each(function(index) {
                    fila[headers[index]] = $(this).text().trim();
                });
                datos.push(fila);
            });

            if (datos.length === 0) {
                ShowNotificacion("warning", "Advertencia", "No hay datos para exportar", "4", "0");
                return;
            }

            // Crear CSV
            var csv = headers.join(',') + '\n';
            datos.forEach(function(row) {
                var valores = headers.map(function(h) {
                    return '"' + (row[h] || '').replace(/"/g, '""') + '"';
                });
                csv += valores.join(',') + '\n';
            });

            // Descargar CSV
            var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Costos_Cero_Inactivos_' + new Date().toISOString().slice(0,10) + '.csv';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            ShowNotificacion("success", "Información", "Archivo CSV generado correctamente.", "4", "0");
        }

        // ===== INICIALIZAR DATATABLE =====
        $(document).ready(function () {
            $('.tabla-datos tr td').dblclick(function () {
                var control = ($(this).parent().find('td:last > .btn-detalles'));
                control.click();
            });

            $(".dataTable-simple").DataTable({
                paging: false,
                searching: false,
                ordering: false,
                responsive: false,
                language: {
                    "emptyTable": "Sin información",
                    "infoEmpty": "No se encontro información",
                    "lengthMenu": "_MENU_ registros por p&#225;gina",
                    "zeroRecords": "Sin información",
                    "info": "Registros del <b>_START_</b> al <b>_END_</b> de un total de <b>_TOTAL_</b>",
                },
                order: [
                    [0, 'asc']
                ],
                lengthMenu: [
                    [25, 50, 100, -1],
                    [25, 50, 100, "Todos"]
                ],
                lengthChange: false,
                pageLength: 25,
                info: false
            });
        });
    </script>
}